# TECHOHUB environment variable template (no real secrets).
# Copy this file to `.env` locally and fill in secret values.
# Never commit `.env`. It is gitignored.

# ---------------------------------------------------------------------------
# Backend (Render secret store / local process environment).
# These must NEVER be sent to the React frontend.
# ---------------------------------------------------------------------------

# Groq LLM key for intent classification (optional; rules fast path works without it).
GROQ_API_KEY=your-groq-api-key-here

# Staff ticket API key. Protects GET /api/staff/tickets*. Fail closed if missing.
STAFF_API_KEY=your-staff-api-key-here

# Optional Groq tuning (bounded retry policy; at most one retry, ~8s total).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=5
GROQ_MAX_RETRIES=1
GROQ_TOTAL_DEADLINE_SECONDS=8
GROQ_BACKOFF_SECONDS=0.25

# ---------------------------------------------------------------------------
# Render free-tier feature flags (OFF by default on Render Free).
# Semantic RAG and MCP are preserved in code for local use but disabled on
# Render Free to stay within CPU/RAM limits. Do not claim they work publicly
# unless verified.
# ---------------------------------------------------------------------------

TECHOHUB_RAG_ENABLED=false
TECHOHUB_RAG_PROVIDER=lexical
TECHOHUB_MCP_ENABLED=false

# ---------------------------------------------------------------------------
# CORS. Default (empty) allows NO cross-origin browser traffic.
# Set to the public Vercel frontend origin AFTER Vercel deployment.
# Do not use "*" for session-scoped endpoints.
# Example: TECHOHUB_CORS_ORIGINS=https://techohub.vercel.app
# ---------------------------------------------------------------------------

TECHOHUB_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Optional database. Default is ephemeral ./data/techohub.db (Render Free:
# filesystem is ephemeral, conversation history may disappear on redeploy).
# ---------------------------------------------------------------------------

# DATABASE_URL=sqlite:///./data/techohub.db

# ---------------------------------------------------------------------------
# Frontend (Vite). VITE_* variables are public browser configuration,
# NOT secret storage. Do not put GROQ_API_KEY or STAFF_API_KEY here.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=https://your-backend.onrender.com
